@model InventoryManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<h1>Supplier Details</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">
                Supplier Name
            </dt>
            <dd class="col-sm-8">
                @Model.SupplierName
            </dd>

            <dt class="col-sm-4">
                Email
            </dt>
            <dd class="col-sm-8">
                @Model.Email
            </dd>

            <dt class="col-sm-4">
                Phone
            </dt>
            <dd class="col-sm-8">
                @Model.Phone
            </dd>

            <dt class="col-sm-4">
                Address
            </dt>
            <dd class="col-sm-8">
                @Model.Address
            </dd>
        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.SupplierId"
           class="btn btn-warning">Edit</a>

        <a asp-action="Index"
           class="btn btn-secondary">Back to List</a>
    </div>
</div>
