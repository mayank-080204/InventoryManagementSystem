@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Product Name</dt>
            <dd class="col-sm-8">@Model.ProductName</dd>

            <dt class="col-sm-4">SKU</dt>
            <dd class="col-sm-8">@Model.SKU</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">@Model.Price.ToString("N2")</dd>

            <dt class="col-sm-4">Stock Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>

            <dt class="col-sm-4">Reorder Level</dt>
            <dd class="col-sm-8">@Model.ReorderLevel</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "Not assigned")</dd>

            <dt class="col-sm-4">Supplier</dt>
            <dd class="col-sm-8">@(Model.Supplier?.SupplierName ?? "Not assigned")</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.ProductId"
           class="btn btn-primary">Edit</a>

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
