@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<h3>Are you sure you want to delete this product?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Product Name</dt>
    <dd class="col-sm-9">@Model.ProductName</dd>

    <dt class="col-sm-3">SKU</dt>
    <dd class="col-sm-9">@Model.SKU</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("F2")</dd>

    <dt class="col-sm-3">Stock Quantity</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>

    <dt class="col-sm-3">Reorder Level</dt>
    <dd class="col-sm-9">@Model.ReorderLevel</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ProductId" />
    <input type="submit" value="Confirm Delete"
           class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
